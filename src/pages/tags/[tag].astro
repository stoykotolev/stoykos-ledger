---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingTime } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const id = (title: string) => {
  const m = title.match(/(\d+)/);
  return (m ? m[1] : "0").padStart(4, "0");
};
const iso = (d: Date) => d.toISOString().slice(0, 10);
const clip = (s: string, n: number) =>
  s.length > n ? s.slice(0, n - 1).trimEnd() + "…" : s;
---

<Base title={`#${tag} — stoykotolev.com`}>
  <a href="/tags" class="lg-back">← all tags</a>
  <h1 class="lg-h1">#{tag}</h1>
  <p class="lg-sub">
    {posts.length} entr{posts.length !== 1 ? "ies" : "y"}
  </p>

  <div class="lg-cols" aria-hidden="true">
    <span>ENTRY</span><span>DATE</span><span>TITLE</span><span class="col-read"
      >READ</span
    >
  </div>
  <ol class="lg-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="lg-line">
            <span class="lg-id">#{id(post.data.title)}</span>
            <span class="lg-dt">{iso(post.data.date)}</span>
            <span class="lg-main-cell">
              <span class="lg-t">{clip(post.data.description, 58)}</span>
              <span class="lg-dots" />
              <span class="lg-read">{readingTime(post.body ?? "")}m</span>
            </span>
            <span class="lg-tags">{post.data.tags.slice(0, 4).join(" · ")}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>
