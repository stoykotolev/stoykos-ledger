---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { readingTime } from "../lib/utils";

const idOf = (t: string) => (t.match(/(\d+)/)?.[1] ?? "0").padStart(4, "0");

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    slug: p.id,
    id: idOf(p.data.title),
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
    date: p.data.date.toISOString().slice(0, 10),
    read: readingTime(p.body ?? ""),
    body: p.body ?? "",
  }));

// Escape "<" so the JSON island can't break out of the <script> tag.
const dataJson = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<Base title="Search — stoykotolev.com">
  <h1 class="lg-h1">Search</h1>
  <p class="lg-sub">grep the ledger</p>

  <div class="lg-prompt">
    <span class="lg-user">stoyko@ledger</span>:<span class="lg-cwd"
      >~/ledger</span
    >$ grep -i
  </div>

  <input
    id="search-input"
    type="search"
    placeholder="type to search entries…"
    autocomplete="off"
    class="lg-input"
  />

  <div id="search-cols" class="lg-cols" aria-hidden="true" style="display:none">
    <span>ENTRY</span><span>DATE</span><span>TITLE</span><span class="col-read"
      >READ</span
    >
  </div>
  <ol id="results" class="lg-list"></ol>
  <p id="results-empty" class="lg-empty"></p>

  <script type="application/json" id="search-data" set:html={dataJson}></script>
  <script>
    import Fuse from "fuse.js";

    type Entry = {
      slug: string;
      id: string;
      title: string;
      description: string;
      tags: string[];
      date: string;
      read: number;
      body: string;
    };

    const dataEl = document.getElementById("search-data");
    const posts: Entry[] = JSON.parse(dataEl?.textContent || "[]");
    const fuse = new Fuse<Entry>(posts, {
      keys: ["title", "description", "tags", "body"],
      threshold: 0.4,
      minMatchCharLength: 2,
    });

    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const cols = document.getElementById("search-cols");
    const results = document.getElementById("results");
    const empty = document.getElementById("results-empty");

    const clip = (s: string, n: number) =>
      s.length > n ? s.slice(0, n - 1).trimEnd() + "…" : s;

    function rowsHtml(items: { item: Entry }[]) {
      return items
        .map(
          ({ item: p }) => `
        <li><a href="/blog/${p.slug}" class="lg-line">
          <span class="lg-id">#${p.id}</span>
          <span class="lg-dt">${p.date}</span>
          <span class="lg-main-cell"><span class="lg-t">${clip(p.description, 58)}</span><span class="lg-dots"></span><span class="lg-read">${p.read}m</span></span>
          <span class="lg-tags">${p.tags.slice(0, 4).join(" · ")}</span>
        </a></li>`,
        )
        .join("");
    }

    function show(q: string) {
      if (!results || !cols || !empty) return;
      if (!q) {
        results.innerHTML = "";
        cols.style.display = "none";
        empty.textContent = "";
        return;
      }
      const found = fuse.search(q).slice(0, 12);
      if (!found.length) {
        results.innerHTML = "";
        cols.style.display = "none";
        empty.textContent = "no matching entries.";
        return;
      }
      empty.textContent = "";
      cols.style.display = "";
      results.innerHTML = rowsHtml(found);
    }

    input?.addEventListener("input", (e) =>
      show((e.target as HTMLInputElement).value.trim()),
    );
  </script>
</Base>
