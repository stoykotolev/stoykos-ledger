---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { readingTime } from "../lib/utils";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const id = (title: string) => {
  const m = title.match(/(\d+)/);
  return (m ? m[1] : "0").padStart(4, "0");
};
const iso = (d: Date) => d.toISOString().slice(0, 10);
const clip = (s: string, n: number) =>
  s.length > n ? s.slice(0, n - 1).trimEnd() + "…" : s;
---

<Base title="stoykotolev.com — a technical ledger">
  <pre class="lg-banner">┌─ THE LEDGER ─────────────────────────────────┐
│  an append-only log of things worth keeping  │
└──────────────────────────────────────────────┘</pre>

  <p class="lg-intro">
    Hi, I'm Stoyko. A running log of software I'm building, tools I'm
    sharpening, and ideas I find worth keeping — part continuous project, part
    archive. A new entry lands every couple of weeks. Find me on <a
      href="https://github.com/stoykotolev"
      target="_blank"
      rel="noopener noreferrer">GitHub</a
    > or send me an <button id="copy-email" type="button"
      ><span id="copy-email-label">email</span></button
    >.
  </p>

  <div class="lg-prompt">
    <span class="lg-user">stoyko@ledger</span>:<span class="lg-cwd"
      >~/ledger</span
    >$ cat ./entries --tail<span class="lg-caret" aria-hidden="true"></span>
  </div>

  <div class="lg-cols" aria-hidden="true">
    <span>ENTRY</span><span>DATE</span><span>TITLE</span><span class="col-read"
      >READ</span
    >
  </div>

  <ol class="lg-list">
    {
      posts.map((post) => {
        const tags = post.data.tags;
        const shown = tags.slice(0, 4).join(" · ");
        const extra = tags.length > 4 ? ` +${tags.length - 4}` : "";
        return (
          <li>
            <a href={`/blog/${post.slug}`} class="lg-line">
              <span class="lg-id">#{id(post.data.title)}</span>
              <span class="lg-dt">{iso(post.data.date)}</span>
              <span class="lg-main-cell">
                <span class="lg-t">{clip(post.data.description, 58)}</span>
                <span class="lg-dots" />
                <span class="lg-read">{readingTime(post.body)}m</span>
              </span>
              <span class="lg-tags">
                {shown}
                {extra}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <script>
    const btn = document.getElementById("copy-email");
    const label = document.getElementById("copy-email-label");
    const parts = ["stoyko", "stoykotolev", "com"];
    const addr = `${parts[0]}@${parts[1]}.${parts[2]}`;
    btn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(addr);
        if (label) {
          label.textContent = "copied!";
          setTimeout(() => (label.textContent = "email"), 2000);
        }
      } catch {
        // ignore: clipboard may be blocked
      }
    });
  </script>
</Base>
