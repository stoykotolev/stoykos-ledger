---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  ogImage?: string;
};

const {
  title,
  description = "Technical blog by Stoyko Tolev",
  ogImage,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname.replace(/\/+$/, "");
const loc = path === "" ? "~/ledger" : "~" + path;
const section = path.startsWith("/tags")
  ? "tags"
  : path.startsWith("/search")
    ? "search"
    : "blog";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="slate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="stoykotolev.com"
      href="/rss.xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      const t = localStorage.getItem("ledger-theme");
      if (t === "slate" || t === "teal" || t === "amber") {
        document.documentElement.dataset.theme = t;
      }
    </script>
  </head>
  <body>
    <div class="lg-vignette" aria-hidden="true"></div>
    <div class="lg-scan" aria-hidden="true"></div>

    <div class="lg-page">
      <header class="lg-top">
        <div class="lg-top-inner">
          <a href="/" class="lg-host">stoyko@ledger</a>
          <div class="lg-top-right">
            <nav class="lg-nav">
              <a
                href="/"
                class="lg-bracket"
                aria-current={section === "blog" ? "page" : undefined}>blog</a
              >
              <a
                href="/tags"
                class="lg-bracket"
                aria-current={section === "tags" ? "page" : undefined}>tags</a
              >
              <a
                href="/search"
                class="lg-bracket"
                aria-current={section === "search" ? "page" : undefined}
                >search</a
              >
            </nav>
            <span class="lg-divider" aria-hidden="true"></span>
            <div class="lg-themes" role="group" aria-label="Theme">
              <button class="lg-theme lg-bracket" type="button" data-theme="slate"
                >slate</button
              >
              <button class="lg-theme lg-bracket" type="button" data-theme="teal"
                >teal</button
              >
              <button class="lg-theme lg-bracket" type="button" data-theme="amber"
                >amber</button
              >
            </div>
          </div>
        </div>
      </header>

      <main class="lg-main">
        <slot />
      </main>

      <footer class="lg-status">
        <div class="lg-status-inner">
          <span class="seg mode">NORMAL</span>
          <span class="seg path">{loc}</span>
          <span class="spacer"></span>
          <span class="seg right"
            >&copy; {year} &middot; <a href="/rss.xml">rss</a></span
          >
        </div>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const valid = ["slate", "teal", "amber"];
      const btns = Array.from(document.querySelectorAll<HTMLElement>(".lg-theme"));
      function setTheme(t: string) {
        if (!valid.includes(t)) t = "slate";
        root.dataset.theme = t;
        try {
          localStorage.setItem("ledger-theme", t);
        } catch {
          // ignore: storage may be unavailable (private mode, etc.)
        }
        btns.forEach((b) =>
          b.classList.toggle("is-active", b.dataset.theme === t),
        );
      }
      btns.forEach((b) =>
        b.addEventListener("click", () => setTheme(b.dataset.theme ?? "slate")),
      );
      setTheme(localStorage.getItem("ledger-theme") || root.dataset.theme || "slate");
    </script>
  </body>
</html>
