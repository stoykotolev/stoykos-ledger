---
import { Image } from "astro:assets";
import Base from "./Base.astro";
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../lib/utils";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { title, description, date, tags, heroImage, heroImageAlt } = post.data;
const { Content, headings } = await post.render();

const toc = headings.filter((h) => h.depth <= 3);
const id = (title.match(/(\d+)/)?.[1] ?? "0").padStart(4, "0");
const iso = date.toISOString().slice(0, 10);
const ogImage = heroImage
  ? new URL(heroImage.src, Astro.site).toString()
  : undefined;
---

<Base title={`#${id} — ${description}`} description={description} ogImage={ogImage}>
  <article>
    <header class="lg-entry-head">
      <div class="lg-entry-id">
        <span class="num">#{id}</span>
        <span class="rule"></span>
        <span>{iso}</span>
      </div>
      <h1 class="lg-entry-title">{description}</h1>
      <p class="lg-entry-meta">
        {readingTime(post.body)} min read ·{" "}
        {
          tags.map((t, i) => (
            <>
              {i > 0 ? " · " : ""}
              <a href={`/tags/${t}`}>#{t}</a>
            </>
          ))
        }
      </p>
    </header>

    {
      heroImage && (
        <Image
          class="lg-entry-hero"
          src={heroImage}
          alt={heroImageAlt ?? ""}
          widths={[480, 768, heroImage.width]}
          sizes="(min-width: 68ch) 68ch, 100vw"
        />
      )
    }

    {
      toc.length > 2 && (
        <nav class="lg-toc">
          <p class="lg-toc-label">Contents</p>
          <ul>
            {toc.map((h) => (
              <li style={`padding-left:${(h.depth - 1) * 12}px`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="lg-entry-foot">
      <div class="lg-chips">
        {tags.map((t) => <a href={`/tags/${t}`} class="lg-chip">#{t}</a>)}
      </div>
    </footer>
  </article>
</Base>
